generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  UserRole               @default(USER)
  accounts              Account[]
  isTwoFactorEnabled    Boolean                @default(false)
  twoFactorConfirmation TwoFactorConfirmation?

  phone                 String?                @default("")
  address               String?                @default("")
  province              String?                @default("") 
  ward                  String?                @default("")

  orders                Order[]
  createdAt             DateTime?              @default(now())
  updatedAt             DateTime?              @updatedAt

  @@map("users")
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.String
  access_token      String?  @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.String
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  sku             String      @unique
  slug            String      @unique
  name            String
  price           Float
  variants        Variant[]
  lifestyleImages String[]
  category        Category
  brand           String      @default("La Marzocco")
  mainImage       String?
  detailImages    String[]
  description     Description
  inStock         Boolean     @default(true)
  techSpecs       TechSpecs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

enum Category {
  ESPRESSO_MACHINE @map("espresso-machine")
  GRINDER_MACHINE  @map("grinder-machine")
  COFFEE_BEANS     @map("coffee-beans")
  ACCESSORIES      @map("accessories")
}

type Variant {
  color     String?
  colorCode String?
  stock     Int      @default(0)
  images    String[]
}

type Description {
  productFeatures   String[]
  introText         TextContent[]
  middleBannerImage String[]
  highlightFeatures TextContent[]
  essentialFeatures TextContent[]
}

type TextContent {
  title   String?
  content String?
}

type TechSpecs {
  origin                       String?
  dimensions                   String?
  weight                       String?
  voltage                      String?
  wattage                      String?
  material                     String?
  amperage                     String?
  coffeeBoiler                 String?
  steamBoiler                  String?
  burrs                        String?
  hopperCapacity               String?
  productivity                 String?
  grindAdjustment              String?
  grindingSpeed                String?
  programmableDose             Boolean?
  diameter                     String?
  distributionSideMaximumDepth String?
  tamperSideMaximumDepth       String?
  ApproximateWeight            String?
}

model Order {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId              String        @unique
  userId               String?       @db.ObjectId
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingInfo         ShippingInfo
  orderItems           OrderItem[]
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(UNPAID)
  paymentTransactionId String?
  totalPrice           Int
  status               OrderStatus   @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@map("orders")
}

type ShippingInfo {
  fullName String
  email    String
  phone    String
  address  String
  ward     String
  province String
  note     String? @default("")
}

type OrderItem {
  productId String? @db.ObjectId
  name      String
  quantity  Int
  image     String
  price     Int
  color     String?
}

enum OrderStatus {
  PENDING    @map("Pending")
  PROCESSING @map("Processing")
  SHIPPED    @map("Shipped")
  DELIVERED  @map("Delivered")
  CANCELLED  @map("Cancelled")
}

enum PaymentStatus {
  UNPAID   @map("Unpaid")
  PAID     @map("Paid")
  FAILED   @map("Failed")
  REFUNDED @map("Refunded")
}

enum PaymentMethod {
  COD     @map("cod")
  BANK    @map("bank")
  ZALOPAY @map("zalopay")
  VNPAY   @map("vnpay")
}

model Blog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  description String?
  content     String
  thumbnail   String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}